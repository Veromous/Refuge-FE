# Production build values, baked in by Vite during `npm run build`.
# Both are PUBLIC values (a URL and an OAuth client id), so committing them is
# safe. This file is loaded automatically for production builds, including the
# Cloudflare build, so no dashboard variables are needed.

# Backend API origin (no trailing slash). Requests go to `${VITE_API_URL}/api/...`.
VITE_API_URL=https://refugebe-b2uf10m7.b4a.run

# Google OAuth client id (public, safe to expose in the browser).
VITE_GOOGLE_CLIENT_ID=371502387250-jotmiqbmmujek86vsfcq5cu35aqokcfs.apps.googleusercontent.com
